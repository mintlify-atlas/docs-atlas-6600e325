    "GET /api/v1/streams — List active streams",
    "GET /api/v1/clients — List connected clients",
    "DELETE /api/v1/clients/:id — Kick a client",
    "POST /rtc/v1/publish/ — WebRTC publish (WHIP)",
    "POST /rtc/v1/play/ — WebRTC play (WHEP)",
